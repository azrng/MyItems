<!-- 暖仓启动图标前景：陶土橙提篮，内容收在 108dp 视口的中央安全区（21..87）内 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 提手 -->
    <path
        android:strokeColor="#BE5E18"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,42 A16,16 0 0 1 70,42" />

    <!-- 篮身：accent → accent-deep 纵向渐变 -->
    <path android:pathData="M34,50 L74,50 L70,78 Q69.4,82 65,82 L43,82 Q38.6,82 38,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="50"
                android:endX="54" android:endY="82"
                android:type="linear">
                <item android:offset="0" android:color="#FFDE7931" />
                <item android:offset="1" android:color="#FFBE5E18" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 编织纹：on-accent 半透明横竖线 -->
    <path
        android:strokeColor="#66FFF7EC"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M36,61 L72,61 M37.4,72 L70.6,72 M46.5,52 L45,80 M61.5,52 L63,80" />

    <!-- 篮沿 -->
    <path
        android:fillColor="#BE5E18"
        android:pathData="M29,39 L79,39 Q82,39 82,42.5 L82,46.5 Q82,50 79,50 L29,50 Q26,50 26,46.5 L26,42.5 Q26,39 29,39 Z" />
</vector>
