<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    x:Class="MyItems.Views.ScannerPage"
    Title="扫一扫"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Camera view (full screen) -->
        <zxing:CameraBarcodeReaderView
            x:Name="CameraView"
            BarcodesDetected="OnBarcodesDetected" />

        <!-- Overlay -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Modern top bar with gradient -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*"
                Padding="16,48,16,16">
                <Button
                    Grid.Column="0"
                    Text="✕"
                    FontSize="24"
                    TextColor="{DynamicResource ModernTextInverse}"
                    BackgroundColor="#CC000000"
                    WidthRequest="48"
                    HeightRequest="48"
                    CornerRadius="24"
                    Clicked="OnCloseClicked" />
                <Label
                    Grid.Column="1"
                    Text="📱 扫一扫"
                    TextColor="{DynamicResource ModernTextInverse}"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,0,48,0" />
            </Grid>

            <!-- Center scan frame area - Modern design -->
            <Grid Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Semi-transparent background -->
                <BoxView
                    WidthRequest="280"
                    HeightRequest="280"
                    Color="#40000000"
                    CornerRadius="24" />
                <!-- Modern scan frame border (4 corners with brand color) -->
                <AbsoluteLayout WidthRequest="280" HeightRequest="280">
                    <!-- Top-left corner -->
                    <BoxView AbsoluteLayout.LayoutBounds="0,0,40,4" Color="{DynamicResource ModernPrimary}" />
                    <BoxView AbsoluteLayout.LayoutBounds="0,0,4,40" Color="{DynamicResource ModernPrimary}" />
                    <!-- Top-right corner -->
                    <BoxView AbsoluteLayout.LayoutBounds="240,0,40,4" Color="{DynamicResource ModernPrimary}" />
                    <BoxView AbsoluteLayout.LayoutBounds="276,0,4,40" Color="{DynamicResource ModernPrimary}" />
                    <!-- Bottom-left corner -->
                    <BoxView AbsoluteLayout.LayoutBounds="0,276,40,4" Color="{DynamicResource ModernPrimary}" />
                    <BoxView AbsoluteLayout.LayoutBounds="0,240,4,40" Color="{DynamicResource ModernPrimary}" />
                    <!-- Bottom-right corner -->
                    <BoxView AbsoluteLayout.LayoutBounds="240,276,40,4" Color="{DynamicResource ModernPrimary}" />
                    <BoxView AbsoluteLayout.LayoutBounds="276,240,4,40" Color="{DynamicResource ModernPrimary}" />

                    <!-- Scan line animation -->
                    <BoxView
                        AbsoluteLayout.LayoutBounds="10,70,260,2"
                        Color="{DynamicResource ModernPrimary}"
                        Opacity="0.8" />
                </AbsoluteLayout>
            </Grid>

            <!-- Bottom controls -->
            <VerticalStackLayout
                Grid.Row="2"
                Padding="16,0,16,48"
                Spacing="12"
                HorizontalOptions="Center">
                <!-- Modern torch button -->
                <Button
                    x:Name="TorchButton"
                    Text="💡 手电筒"
                    TextColor="{DynamicResource ModernTextInverse}"
                    BackgroundColor="#CC000000"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    Clicked="OnTorchClicked"
                    WidthRequest="160"
                    HeightRequest="52" />
                <Label
                    Text="将条码/二维码放入框内即可自动扫描"
                    TextColor="#D0FFFFFF"
                    FontSize="14"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Modern unsupported platform message -->
        <VerticalStackLayout
            x:Name="UnsupportedPanel"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16"
            Padding="40">
            <!-- Large icon container -->
            <Frame
                WidthRequest="100"
                HeightRequest="100"
                CornerRadius="50"
                BackgroundColor="{DynamicResource ModernPrimary}"
                HasShadow="True"
                HorizontalOptions="Center"
                Padding="0">
                <Frame.Shadow>
                    <Shadow Brush="{DynamicResource ModernPrimary}"
                            Opacity="0.3"
                            Radius="24"
                            Offset="0,8"/>
                </Frame.Shadow>
                <Label Text="📷"
                       FontSize="48"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>
            <Label
                Text="当前平台不支持相机扫码"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{DynamicResource ModernTextPrimary}"
                HorizontalOptions="Center" />
            <Label
                Text="请在 Android 或 iOS 设备上使用此功能"
                FontSize="14"
                TextColor="{DynamicResource ModernTextSecondary}"
                HorizontalOptions="Center"
                Margin="0,0,0,16"/>
            <Button
                Text="返回"
                BackgroundColor="{DynamicResource ModernPrimary}"
                TextColor="{DynamicResource ModernTextInverse}"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52"
                Clicked="OnCloseClicked"
                WidthRequest="160"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
