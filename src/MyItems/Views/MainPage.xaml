<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    x:Class="MyItems.Views.MainPage"
    x:DataType="viewmodels:MainViewModel"
    Title="我的物品"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:ExpiryStatusToTextColorConverter x:Key="StatusToTextColor" />
        <converters:ExpiryStatusToBgColorConverter x:Key="StatusToBgColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Search bar + Add button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
              Margin="16,8"
              ColumnSpacing="{StaticResource SpacingSm}">
            <SearchBar
                Grid.Column="0"
                Placeholder="搜索物品..."
                Text="{Binding SearchText}"
                SearchCommand="{Binding RefreshCommand}" />
            <Button
                Grid.Column="1"
                Text="＋"
                Style="{StaticResource IconButton}"
                Command="{Binding GoToAddCommand}"
                VerticalOptions="Center" />
        </Grid>

        <!-- Recent items list with pull-to-refresh -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{StaticResource AppPrimaryColor}">
            <CollectionView
                ItemsSource="{Binding RecentItems}"
                Margin="16,0"
                ItemSizingStrategy="MeasureFirstItem"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:BatchDisplayDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItem
                                    Text="删除"
                                    BackgroundColor="#EF4444"
                                    Invoked="OnDeleteBatchSwipe"
                                    CommandParameter="{Binding BatchId}" />
                            </SwipeView.RightItems>
                            <Frame Style="{StaticResource ListCardStyle}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ViewItemDetailCommand}"
                                        CommandParameter="{Binding ItemId}" />
                                </Frame.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpacingXs}">

                                    <!-- Row 0: Name + status badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ItemName}"
                                               Style="{StaticResource TitleLabel}"
                                               LineBreakMode="TailTruncation" />
                                        <Frame Grid.Column="1"
                                               Style="{StaticResource StatusBadgeFrame}"
                                               BackgroundColor="{Binding ExpiryStatus, Converter={StaticResource StatusToBgColor}}">
                                            <Frame.Triggers>
                                                <DataTrigger TargetType="Frame" Binding="{Binding ExpiryStatus}" Value="NoExpiry">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Frame.Triggers>
                                            <Label Text="{Binding ExpiryStatusText}"
                                                   Style="{StaticResource StatusBadgeLabel}"
                                                   TextColor="{Binding ExpiryStatus, Converter={StaticResource StatusToTextColor}}" />
                                        </Frame>
                                    </Grid>

                                <!-- Row 1: BatchLabel · Brand · Category · Location -->
                                <Label Grid.Row="1"
                                       LineBreakMode="TailTruncation"
                                       Style="{StaticResource BodyLabel}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2} · {3}">
                                            <Binding Path="BatchLabel" />
                                            <Binding Path="Brand" TargetNullValue="" />
                                            <Binding Path="CategoryName" />
                                            <Binding Path="Location" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <!-- Row 2: Expiry date only -->
                                <Label Grid.Row="2"
                                       Style="{StaticResource CaptionLabel}"
                                       Text="{Binding ExpiryDate, StringFormat='保质期 {0:yyyy-MM-dd}'}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ExpiryDate}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Load more indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoadingMore}"
            IsVisible="{Binding IsLoadingMore}"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,16"
            Color="{StaticResource AppPrimaryColor}" />

        <!-- Empty state -->
        <StackLayout
            Grid.Row="1"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="8">
            <Label Text="📦"
                   FontSize="40"
                   HorizontalOptions="Center" />
            <Label Text="最近 7 天没有新增物品"
                   Style="{StaticResource BodyLabel}"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Loading indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource AppPrimaryColor}" />
    </Grid>
</ContentPage>
