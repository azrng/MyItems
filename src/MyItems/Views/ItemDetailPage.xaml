<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    x:Class="MyItems.Views.ItemDetailPage"
    x:DataType="viewmodels:ItemDetailViewModel"
    Title="物品详情"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:ExpiryStatusToTextColorConverter x:Key="StatusToTextColor" />
        <converters:ExpiryStatusToBgColorConverter x:Key="StatusToBgColor" />
        <converters:HasValueConverter x:Key="HasValue" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />

        <Style x:Key="DetailSectionTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="{DynamicResource ModernDisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
        </Style>

        <Style x:Key="DetailCaption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{DynamicResource ModernTextHint}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="DetailValue" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="DetailMutedValue" TargetType="Label" BasedOn="{StaticResource DetailValue}">
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="TextColor" Value="{DynamicResource ModernTextSecondary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,96" Spacing="10">
                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    HorizontalOptions="Center"
                    Color="{DynamicResource ModernPrimary}" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource ModernErrorText}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmpty}}" />

                <Frame
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0"
                    Padding="16"
                    IsVisible="{Binding Item, Converter={StaticResource HasValue}}">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="12">
                        <Frame Grid.RowSpan="2"
                               WidthRequest="72"
                               HeightRequest="72"
                               CornerRadius="36"
                               BackgroundColor="{DynamicResource ModernPrimary}"
                               HasShadow="False"
                               Padding="0"
                               VerticalOptions="Start">
                            <Label Text="{Binding Item.ItemIcon}"
                                   FontSize="34"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Item.ItemName}"
                                   Style="{StaticResource ModernHeadlineLabel}"
                                   FontSize="22"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Item.CategoryName}"
                                   Style="{StaticResource DetailMutedValue}"
                                   FontSize="14" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.Column="1"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <Frame Grid.Column="0"
                                   CornerRadius="12"
                                   Padding="10,4"
                                   HasShadow="False"
                                   BackgroundColor="{Binding Item.ExpiryStatus, Converter={StaticResource StatusToBgColor}}">
                                <Label Text="{Binding Item.ExpiryStatusText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Item.ExpiryStatus, Converter={StaticResource StatusToTextColor}}"
                                       MaxLines="1" />
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="{Binding Item.BrandDisplay, StringFormat='品牌：{0}'}"
                                   Style="{StaticResource DetailCaption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Frame>

                <Frame
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0"
                    Padding="16,14"
                    IsVisible="{Binding Item, Converter={StaticResource HasValue}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="基础信息" Style="{StaticResource DetailSectionTitle}" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="14"
                              RowSpacing="12">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="分类" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.CategoryName}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="存放位置" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.LocationDisplay}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="数量" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.Quantity, StringFormat='{0} 个'}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3"
                                                 IsVisible="{Binding Item.HasBarcode}">
                                <Label Text="条码" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.Barcode}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0"
                    Padding="16,14"
                    IsVisible="{Binding Item, Converter={StaticResource HasValue}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="购买与期限" Style="{StaticResource DetailSectionTitle}" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="14"
                              RowSpacing="12">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="购买日期" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.PurchaseDateText}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="购入价格" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.PurchasePriceText}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="保质期" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.ExpiryDateText}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="日均成本" Style="{StaticResource DetailCaption}" />
                                <Label Text="{Binding Item.DailyCostDisplay}" Style="{StaticResource DetailValue}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding Item.HoldingText}"
                               Style="{StaticResource DetailCaption}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame
                    Style="{StaticResource ModernCardStyle}"
                    Margin="0"
                    Padding="16,14"
                    IsVisible="{Binding Item, Converter={StaticResource HasValue}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="备注" Style="{StaticResource DetailSectionTitle}" />
                        <Label Text="{Binding Item.NotesDisplay}"
                               Style="{StaticResource DetailMutedValue}"
                               LineBreakMode="WordWrap"
                               MaxLines="4" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Frame Grid.Row="1"
               Style="{StaticResource ModernCardStyle}"
               Margin="16,8,16,16"
               Padding="12,10"
               IsVisible="{Binding Item, Converter={StaticResource HasValue}}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="编辑"
                        Style="{StaticResource ModernSecondaryButton}"
                        HeightRequest="46"
                        Command="{Binding EditItemCommand}"/>
                <Button Grid.Column="1"
                        Text="删除"
                        BackgroundColor="{DynamicResource ModernError}"
                        TextColor="{DynamicResource ModernTextInverse}"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="46"
                        Command="{Binding DeleteItemCommand}" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
