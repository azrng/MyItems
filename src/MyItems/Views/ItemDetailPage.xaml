<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    x:Class="MyItems.Views.ItemDetailPage"
    x:DataType="viewmodels:ItemDetailViewModel"
    Title="物品详情"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:ExpiryStatusToTextColorConverter x:Key="StatusToTextColor" />
        <converters:ExpiryStatusToBgColorConverter x:Key="StatusToBgColor" />
        <converters:HasValueConverter x:Key="HasValue" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource SpacingMd}" Padding="{StaticResource PagePadding}">

            <!-- Loading -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="{StaticResource AppPrimaryColor}" />

            <!-- Detail card -->
            <Frame Style="{StaticResource CardStyle}"
                   IsVisible="{Binding Item, Converter={StaticResource NotNullOrEmpty}}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource SpacingSm}">

                    <!-- Row 0: Name + Status badge -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{Binding Item.ItemName}"
                               Style="{StaticResource HeadlineLabel}"
                               LineBreakMode="TailTruncation" />
                        <Frame Grid.Column="1"
                               Style="{StaticResource StatusBadgeFrame}"
                               BackgroundColor="{Binding Item.ExpiryStatus, Converter={StaticResource StatusToBgColor}}">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding Item.ExpiryStatus}" Value="Expired">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="Frame" Binding="{Binding Item.ExpiryStatus}" Value="Safe">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="Frame" Binding="{Binding Item.ExpiryStatus}" Value="NoExpiry">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Label Text="临期"
                                   Style="{StaticResource StatusBadgeLabel}"
                                   TextColor="{Binding Item.ExpiryStatus, Converter={StaticResource StatusToTextColor}}" />
                        </Frame>
                    </Grid>

                    <!-- Row 1: Category + Brand -->
                    <Label Grid.Row="1" Style="{StaticResource BodyLabel}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} · {1}">
                                <Binding Path="Item.CategoryName" />
                                <Binding Path="Item.Brand" TargetNullValue="" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <!-- Row 2: Location -->
                    <Label Grid.Row="2"
                           Style="{StaticResource CaptionLabel}"
                           Text="{Binding Item.Location, StringFormat='存放位置：{0}'}" />

                    <!-- Row 3: CreatedAt label -->
                    <Label Grid.Row="3"
                           Style="{StaticResource CaptionLabel}"
                           Text="{Binding Item.CreatedAtLabel, StringFormat='标识：{0}'}" />

                    <!-- Row 4: Purchase info -->
                    <BoxView Grid.Row="4" HeightRequest="1" Color="{StaticResource AppBorderColor}" />

                    <Label Grid.Row="5" Style="{StaticResource BodyLabel}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}购买日期：{0:yyyy-MM-dd}    价格：¥{1:F1}">
                                <Binding Path="Item.PurchaseDate" />
                                <Binding Path="Item.PurchasePrice" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <!-- Row 6: Expiry + Quantity -->
                    <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource BodyLabel}"
                               Text="{Binding Item.ExpiryDate, StringFormat='保质期：{0:yyyy-MM-dd}'}"
                               IsVisible="{Binding Item.ExpiryDate, Converter={StaticResource HasValue}}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource BodyLabel}"
                               Text="{Binding Item.Quantity, StringFormat='数量：{0}'}" />
                    </Grid>

                    <!-- Row 7: Holding + Daily cost -->
                    <Label Grid.Row="7" Style="{StaticResource CaptionLabel}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}    {1}">
                                <Binding Path="Item.HoldingText" />
                                <Binding Path="Item.DailyCostText" TargetNullValue="" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <!-- Row 8: Notes -->
                    <Label Grid.Row="8"
                           Style="{StaticResource CaptionLabel}"
                           Text="{Binding Item.Notes, StringFormat='备注：{0}'}"
                           IsVisible="{Binding Item.Notes, FallbackValue=''}" />

                    <!-- Row 9: Actions -->
                    <HorizontalStackLayout Grid.Row="9"
                                           Spacing="{StaticResource SpacingSm}"
                                           HorizontalOptions="End">
                        <Button Text="编辑"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding EditItemCommand}" />
                        <Button Text="删除"
                                Style="{StaticResource DangerSoftButton}"
                                Command="{Binding DeleteItemCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
