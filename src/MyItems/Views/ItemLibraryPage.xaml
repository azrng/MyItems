<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    x:Class="MyItems.Views.ItemLibraryPage"
    x:Name="PageRoot"
    x:DataType="viewmodels:ItemLibraryViewModel"
    Title="物品库"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />
        <converters:HasValueConverter x:Key="HasValue" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              HorizontalOptions="Fill"
              VerticalOptions="Center"
              Padding="16,8">
            <Button
                Grid.Column="0"
                Text="☰"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource ModernTextInverse}"
                FontSize="22"
                Padding="0"
                Command="{Binding ToggleSettingsCommand}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.7" />
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <Label
                Grid.Column="1"
                Text="物品库"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{DynamicResource ModernTextInverse}"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- 现代化搜索栏 -->
        <Frame Grid.Row="0"
               Style="{StaticResource ModernCardStyle}"
               Margin="16,10,16,6"
               Padding="10">
            <SearchBar
                Placeholder="搜索物品名称、品牌..."
                Text="{Binding SearchText}"
                SearchCommand="{Binding RefreshCommand}"
                Margin="0"
                BackgroundColor="Transparent"
                FontSize="15"
                HeightRequest="48"/>
        </Frame>

        <!-- 现代化统计摘要 -->
        <Frame Grid.Row="1"
               Style="{StaticResource ModernCardStyle}"
               Margin="16,0,16,6"
               Padding="12,8">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <!-- 个人资产 -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                    <Label Grid.Row="0"
                           Text="{Binding TotalSpentText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource ModernPrimary}"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="1"
                           Text="资产"
                           Style="{StaticResource ModernCaptionLabel}"
                           FontSize="11"
                           HorizontalTextAlignment="Center"/>
                </Grid>

                <!-- 有效商品 -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
                    <Label Grid.Row="0"
                           Text="{Binding ValidCountText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource ModernSuccess}"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="1"
                           Text="有效"
                           Style="{StaticResource ModernCaptionLabel}"
                           FontSize="11"
                           HorizontalTextAlignment="Center"/>
                </Grid>

                <!-- 全部商品 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="2">
                    <Label Grid.Row="0"
                           Text="{Binding TotalItemsText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource ModernSecondary}"
                           LineBreakMode="TailTruncation"
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="1"
                           Text="全部"
                           Style="{StaticResource ModernCaptionLabel}"
                           FontSize="11"
                           HorizontalTextAlignment="Center"/>
                </Grid>
            </Grid>
        </Frame>

        <!-- 现代化分类筛选 -->
        <ScrollView
            Grid.Row="2"
            Margin="16,0,16,6"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never"
            HeightRequest="48">
            <FlexLayout
                BindableLayout.ItemsSource="{Binding Categories}"
                JustifyContent="Start"
                AlignItems="Center"
                Wrap="NoWrap">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SelectableCategory">
                        <Button
                            Text="{Binding Name}"
                            Command="{Binding SelectCommand}"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            FontSize="13"
                            CornerRadius="18"
                            HeightRequest="44">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ModernPrimary}" />
                                    <Setter Property="TextColor" Value="{DynamicResource ModernTextInverse}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ModernSurfaceContainer}" />
                                    <Setter Property="TextColor" Value="{DynamicResource ModernTextSecondary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

        <!-- 现代化物品列表 -->
        <RefreshView
            Grid.Row="3"
            Command="{Binding RefreshCommand}"
            Margin="16,0">
            <CollectionView
                ItemsSource="{Binding Items}"
                ItemSizingStrategy="MeasureFirstItem"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ItemDisplayDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItem
                                    Text="删除"
                                    BackgroundColor="{DynamicResource ModernError}"
                                    Invoked="OnDeleteItemSwipe"
                                    CommandParameter="{Binding ItemId}" />
                            </SwipeView.RightItems>
                            <Frame Style="{StaticResource ModernCardStyle}"
                                   Margin="0,0,0,8"
                                   Padding="12">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ItemLibraryViewModel}}, Path=ViewItemDetailCommand}"
                                        CommandParameter="{Binding ItemId}" />
                                </Frame.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

                                    <!-- Row 0: Icon + Name + Daily cost + Category -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding ItemIcon}"
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               Margin="0"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding ItemName}"
                                               Style="{StaticResource ModernTitleLabel}"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2"
                                               Text="{Binding DailyCostText}"
                                               Style="{StaticResource ModernCaptionLabel}"
                                               FontSize="11"
                                               TextColor="{DynamicResource ModernPrimary}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding DailyCostText, Converter={StaticResource NotNullOrEmpty}}"
                                               Margin="0"/>
                                        <Frame Grid.Column="3"
                                               Style="{StaticResource ModernBadgeStyle}"
                                               Padding="8,4"
                                               BackgroundColor="{DynamicResource ModernPrimary}">
                                            <Label Grid.Column="0"
                                                   Text="{Binding CategoryName}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource ModernTextInverse}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                        </Frame>
                                    </Grid>

                                    <!-- Row 1: Purchase + expiry -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource ModernBodyLabel}"
                                               FontSize="14"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}购买于 {0:yyyy-MM-dd}  ¥{1:F1}">
                                                    <Binding Path="PurchaseDate" />
                                                    <Binding Path="PurchasePrice" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Frame Grid.Column="1"
                                               BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                                               CornerRadius="12"
                                               Padding="10,4"
                                               HasShadow="False"
                                               MinimumWidthRequest="76"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding ExpiryStatusText, Converter={StaticResource NotNullOrEmpty}}">
                                            <Label
                                                Text="{Binding ExpiryStatusText}"
                                                Style="{StaticResource ModernCaptionLabel}"
                                                FontSize="12"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                LineBreakMode="NoWrap"
                                                MaxLines="1"/>
                                        </Frame>
                                    </Grid>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Load more indicator -->
        <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsLoadingMore}"
            IsVisible="{Binding IsLoadingMore}"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,16"
            Color="{DynamicResource ModernPrimary}" />

        <!-- Modern Empty state -->
        <StackLayout
            Grid.Row="3"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16"
            Padding="40">
            <Frame WidthRequest="80" HeightRequest="80"
                   CornerRadius="40"
                   BackgroundColor="{DynamicResource ModernPrimary}"
                   HasShadow="True"
                   Padding="0">
                <Frame.Shadow>
                    <Shadow Brush="{DynamicResource ModernPrimary}"
                            Opacity="0.3"
                            Radius="24"
                            Offset="0,8"/>
                </Frame.Shadow>
                <Label Text="📦"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>
            <Label Text="还没有物品"
                   Style="{StaticResource ModernTitleLabel}"
                   HorizontalOptions="Center"/>
            <Label Text="点击右上角 + 添加你的第一个物品"
                   Style="{StaticResource ModernBodyLabel}"
                   HorizontalOptions="Center"/>
        </StackLayout>

        <!-- Loading -->
        <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{DynamicResource ModernPrimary}" />
        </Grid>

        <!-- Modern Settings drawer overlay -->
        <Border
            ZIndex="101"
            BackgroundColor="{DynamicResource ModernSurface}"
            StrokeThickness="0"
            Padding="16"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            IsVisible="{Binding IsSettingsOpen}"
            Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.16" Radius="18" Offset="3,0"/>
            </Border.Shadow>
            <Grid RowDefinitions="Auto,Auto,*"
                  WidthRequest="300"
                  HorizontalOptions="Start">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <Label Text="设置"
                           Style="{StaticResource ModernTitleLabel}"
                           FontSize="18"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="×"
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            TextColor="{DynamicResource ModernTextPrimary}"
                            FontSize="18"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            Command="{Binding CloseSettingsCommand}"/>
                </Grid>

                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                         Margin="0,0,0,12"/>

                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Button Text="📂  分类管理"
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            TextColor="{DynamicResource ModernTextPrimary}"
                            FontSize="15"
                            HorizontalOptions="Fill"
                            HeightRequest="48"
                            CornerRadius="14"
                            Padding="14,0"
                            Command="{Binding GoToCategoryCommand}"/>

                    <Button Text="💾  存储管理"
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            TextColor="{DynamicResource ModernTextPrimary}"
                            FontSize="15"
                            HorizontalOptions="Fill"
                            HeightRequest="48"
                            CornerRadius="14"
                            Padding="14,0"
                            Command="{Binding GoToStorageCommand}"/>

                    <Button Text="🔍  高级搜索"
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            TextColor="{DynamicResource ModernTextPrimary}"
                            FontSize="15"
                            HorizontalOptions="Fill"
                            HeightRequest="48"
                            CornerRadius="14"
                            Padding="14,0"
                            Command="{Binding OpenAdvancedSearchCommand}"/>

                    <Button Text="ℹ  关于"
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            TextColor="{DynamicResource ModernTextPrimary}"
                            FontSize="15"
                            HorizontalOptions="Fill"
                            HeightRequest="48"
                            CornerRadius="14"
                            Padding="14,0"
                            Command="{Binding GoToAboutCommand}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
