<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
    x:Class="MyItems.Views.ItemLibraryPage"
    x:Name="PageRoot"
    x:DataType="viewmodels:ItemLibraryViewModel"
    Title="物品库"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource SpacingMd}"
              HorizontalOptions="Fill"
              VerticalOptions="Center">
            <Button
                Grid.Column="0"
                Text="☰"
                Style="{StaticResource TitleIconButton}"
                Command="{Binding ToggleSettingsCommand}"
                Padding="0" />
            <Label
                Grid.Column="1"
                Text="物品库"
                FontSize="{StaticResource FontSizeTitle}"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextInverseColor}"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <SearchBar
            Grid.Row="0"
            Style="{StaticResource SearchBarStyle}"
            Margin="16,8"
            Placeholder="搜索物品..."
            Text="{Binding SearchText}"
            SearchCommand="{Binding RefreshCommand}" />

        <!-- Statistics summary -->
        <Frame
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="16,0"
            Padding="12,10">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="个人资产"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding TotalSpentText}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AppPrimaryColor}"
                       HorizontalOptions="Center" />

                <Label Grid.Row="0" Grid.Column="1"
                       Text="有效商品"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding ValidCountText}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AppSafeColor}"
                       HorizontalOptions="Center" />

                <Label Grid.Row="0" Grid.Column="2"
                       Text="全部商品"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="2"
                       Text="{Binding TotalItemsText}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AppTextSecondaryColor}"
                       HorizontalOptions="Center" />
            </Grid>
        </Frame>

        <!-- Category filter chips -->
        <ScrollView
            Grid.Row="2"
            Margin="16,0"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never">
            <toolkit:SfChipGroup
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                DisplayMemberPath="Name"
                ChipType="Choice"
                ChoiceMode="Single"
                ShowIcon="False"
                ItemHeight="32"
                ChipCornerRadius="16"
                ChipPadding="4,4"
                ChipBackground="{DynamicResource AppCardBackgroundColor}"
                ChipTextColor="{DynamicResource AppTextSecondaryColor}"
                ChipStroke="{DynamicResource AppBorderColor}"
                ChipStrokeThickness="1"
                SelectedChipBackground="{DynamicResource AppActiveBackgroundColor}"
                SelectedChipTextColor="{DynamicResource AppPrimaryColor}"
                SelectionIndicatorColor="{DynamicResource AppPrimaryColor}" />
        </ScrollView>

        <!-- Item list -->
        <RefreshView
            Grid.Row="3"
            Command="{Binding RefreshCommand}"
            Margin="16,0">
            <CollectionView
                ItemsSource="{Binding Items}"
                ItemSizingStrategy="MeasureFirstItem"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:ItemDisplayDto">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItem
                                Text="删除"
                                BackgroundColor="{DynamicResource AppErrorColor}"
                                Invoked="OnDeleteItemSwipe"
                                CommandParameter="{Binding ItemId}" />
                        </SwipeView.RightItems>
                        <Frame Style="{StaticResource ListCardStyle}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ItemLibraryViewModel}}, Path=ViewItemDetailCommand}"
                                    CommandParameter="{Binding ItemId}" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                <!-- Row 0: Icon + Name + Daily cost + Category -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding ItemIcon}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           Margin="0,0,6,0" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ItemName}"
                                           Style="{StaticResource TitleLabel}"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2"
                                           Text="{Binding DailyCostText}"
                                           Style="{StaticResource CaptionLabel}"
                                           FontSize="11"
                                           TextColor="{DynamicResource AppPrimaryColor}"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding DailyCostText, Converter={StaticResource NotNullOrEmpty}}" />
                                    <Label Grid.Column="3"
                                           Text="{Binding CategoryName}"
                                           Style="{StaticResource CaptionLabel}"
                                           FontSize="11"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>

                                <!-- Row 1: Purchase date + price -->
                                <Label Grid.Row="1"
                                       Style="{StaticResource BodyLabel}"
                                       LineBreakMode="TailTruncation">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}购买日期 {0:yyyy-MM-dd}    ¥{1:F1}">
                                            <Binding Path="PurchaseDate" />
                                            <Binding Path="PurchasePrice" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <!-- Row 2: Expiry status -->
                                <Label Grid.Row="2"
                                       Style="{StaticResource BodyLabel}"
                                       Text="{Binding ExpiryStatusText}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Load more indicator -->
        <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsLoadingMore}"
            IsVisible="{Binding IsLoadingMore}"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,16"
            Color="{DynamicResource AppPrimaryColor}" />

        <!-- Empty state -->
        <StackLayout
            Grid.Row="3"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="8">
            <Label Text="📦"
                   FontSize="40"
                   HorizontalOptions="Center" />
            <Label Text="还没有物品"
                   Style="{StaticResource BodyLabel}"
                   HorizontalOptions="Center" />
            <Label Text="点击右上角 + 添加你的第一个物品"
                   Style="{StaticResource CaptionLabel}"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Loading -->
        <ActivityIndicator
            Grid.Row="3"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{DynamicResource AppPrimaryColor}" />

        <!-- Settings overlay (dimmed background) -->
        <BoxView
            Grid.RowSpan="4"
            BackgroundColor="Black"
            Opacity="0.4"
            IsVisible="{Binding IsSettingsOpen}"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSettingsCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Settings panel (slides from right) -->
        <Frame
            Grid.RowSpan="4"
            BackgroundColor="{DynamicResource AppCardBackgroundColor}"
            CornerRadius="0"
            Padding="20,32,20,24"
            HasShadow="True"
            WidthRequest="280"
            HorizontalOptions="End"
            IsVisible="{Binding IsSettingsOpen}">
            <VerticalStackLayout Spacing="16">
                <Button Text="📂 分类管理"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppTextColor}"
                        HorizontalOptions="Fill"
                        Command="{Binding GoToCategoryCommand}" />
                <Button Text="💾 存储管理"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppTextColor}"
                        HorizontalOptions="Fill"
                        Command="{Binding GoToStorageCommand}" />
                <Button Text="ℹ 关于"
                        FontSize="18"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppTextColor}"
                        HorizontalOptions="Fill"
                        Command="{Binding GoToAboutCommand}" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
