<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
    x:Class="MyItems.Views.CategoryPage"
    x:Name="PageRoot"
    x:DataType="viewmodels:CategoryViewModel"
    Title="分类管理"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Icon selector -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="16,8,16,0">
            <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding AvailableIcons}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SelectableIcon">
                        <Border WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="Transparent"
                                StrokeThickness="2"
                                StrokeColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AppActiveBackgroundColor}" />
                                    <Setter Property="StrokeColor" Value="{StaticResource AppPrimaryColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectNewIconCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Icon}" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Add category -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="{StaticResource PagePadding}"
              ColumnSpacing="{StaticResource SpacingSm}">
            <Entry
                Grid.Column="0"
                Text="{Binding NewCategoryName}"
                Placeholder="新分类名称"
                Style="{StaticResource EntryStyle}" />
            <Button
                Grid.Column="1"
                Text="新增"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding AddCategoryCommand}"
                WidthRequest="80" />
        </Grid>

        <!-- Category list -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Categories}"
            Margin="{StaticResource PagePadding}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:CategoryDto">
                    <Frame Style="{StaticResource ListCardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" HeightRequest="{StaticResource TouchTargetMinHeight}">

                            <Label Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource SubheadLabel}" />
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding SubtitleText}"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Label Text="·"
                                           Style="{StaticResource CaptionLabel}" />
                                    <Label Text="编辑"
                                           Style="{StaticResource CaptionLabel}"
                                           TextColor="{StaticResource AppPrimaryColor}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.EditCategoryCommand, Source={x:Reference PageRoot}}"
                                                CommandParameter="{Binding}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding SortOrder, StringFormat='排序 {0}'}"
                                           Style="{StaticResource CaptionLabel}"
                                           TextColor="{StaticResource AppTextMutedColor}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Sort buttons -->
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center"
                                                  IsVisible="{Binding IsPreset, Converter={StaticResource InvertedBool}}">
                                <Button Text="↑"
                                        FontSize="12"
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource AppPrimaryColor}"
                                        Command="{Binding BindingContext.SortUpCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="↓"
                                        FontSize="12"
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource AppPrimaryColor}"
                                        Command="{Binding BindingContext.SortDownCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>

                            <!-- Active toggle -->
                            <toolkit:SfSwitch Grid.Column="3"
                                              IsOn="{Binding IsActive}"
                                              VerticalOptions="Center"
                                              WidthRequest="44"
                                              HeightRequest="24" />

                            <!-- Delete button -->
                            <Button Grid.Column="4"
                                    Text="删除"
                                    Style="{StaticResource DangerSoftButton}"
                                    IsVisible="{Binding IsPreset, Converter={StaticResource InvertedBool}}"
                                    Command="{Binding BindingContext.DeleteCategoryCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading -->
        <ActivityIndicator
            Grid.Row="2"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource AppPrimaryColor}" />
    </Grid>
</ContentPage>
