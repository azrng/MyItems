<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    x:Class="MyItems.Views.CategoryPage"
    x:DataType="viewmodels:CategoryViewModel"
    Title="分类管理"
    Style="{StaticResource PageStyle}">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Padding="{StaticResource PagePadding}"
            ColumnSpacing="{StaticResource SpacingSm}">
            <Entry
                Grid.Column="0"
                Text="{Binding NewCategoryName}"
                Placeholder="新分类名称"
                Style="{StaticResource EntryStyle}" />
            <Button
                Grid.Column="1"
                Text="新增"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding AddCategoryCommand}"
                WidthRequest="80" />
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView
                ItemsSource="{Binding Categories}"
                Margin="{StaticResource PagePadding}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:CategoryDto">
                        <Frame Style="{StaticResource ListCardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="{StaticResource TouchTargetMinHeight}">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Icon}"
                                    FontSize="{StaticResource FontSizeTitle}"
                                    VerticalOptions="Center"
                                    Margin="0,0,12,0" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource SubheadLabel}" />
                                    <Label Text="{Binding SubtitleText}" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                    <Button Text="↑"
                                            Style="{StaticResource IconButton}"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            FontSize="14"
                                            Clicked="OnSortUpClicked" />
                                    <Button Text="↓"
                                            Style="{StaticResource IconButton}"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            FontSize="14"
                                            Clicked="OnSortDownClicked" />
                                    <Button Text="删除"
                                            Style="{StaticResource DangerSoftButton}"
                                            Clicked="OnDeleteCategoryClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
