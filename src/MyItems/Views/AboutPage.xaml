<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    x:Class="MyItems.Views.AboutPage"
    x:DataType="viewmodels:AboutViewModel"
    Title="关于"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="16,10,16,24">

            <!-- Compact app summary -->
            <Frame Style="{StaticResource ModernCardStyle}"
                   Margin="0"
                   Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">
                    <Frame Grid.Column="0"
                           WidthRequest="58"
                           HeightRequest="58"
                           CornerRadius="18"
                           BackgroundColor="{DynamicResource ModernPrimary}"
                           HasShadow="False"
                           Padding="0"
                           VerticalOptions="Center">
                        <Label Text="📦"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="{Binding AppName}"
                               Style="{StaticResource ModernTitleLabel}"
                               FontSize="20"/>
                        <Label Text="{Binding Description}"
                               Style="{StaticResource ModernCaptionLabel}"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <Frame Grid.Column="2"
                           BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                           CornerRadius="12"
                           Padding="8,5"
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Label Text="{Binding Version, StringFormat='v{0}'}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ModernTextPrimary}"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- App info -->
            <Frame Style="{StaticResource ModernCardStyle}"
                   Margin="0"
                   Padding="14">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="技术栈"
                               Style="{StaticResource ModernBodyLabel}"/>
                        <Label Grid.Column="1"
                               Text="{Binding TechStack}"
                               Style="{StaticResource ModernSubheadLabel}"
                               FontSize="14"
                               TextColor="{DynamicResource ModernPrimary}"/>
                    </Grid>

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             BackgroundColor="{DynamicResource ModernSurfaceContainer}"/>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Label Text="开发者"
                               Style="{StaticResource ModernBodyLabel}"/>
                        <Label Grid.Column="1"
                               Text="{Binding Author}"
                               Style="{StaticResource ModernSubheadLabel}"
                               FontSize="14"
                               TextColor="{DynamicResource ModernPrimary}"/>
                    </Grid>
                </Grid>
            </Frame>

            <!-- Theme -->
            <Frame Style="{StaticResource ModernCardStyle}"
                   Margin="0"
                   Padding="14">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12"
                      VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="主题"
                               Style="{StaticResource ModernTitleLabel}"
                               FontSize="16"/>
                        <Label Text="选择应用外观"
                               Style="{StaticResource ModernCaptionLabel}"/>
                    </VerticalStackLayout>

                    <Frame Grid.Column="1"
                           BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                           CornerRadius="14"
                           Padding="8,0"
                           HasShadow="False"
                           WidthRequest="150">
                        <Picker Title="选择主题"
                                ItemsSource="{Binding ThemeOptions}"
                                SelectedIndex="{Binding SelectedThemeIndex}"
                                FontSize="14"
                                TextColor="{DynamicResource ModernTextPrimary}"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- Actions -->
            <Frame Style="{StaticResource ModernCardStyle}"
                   Margin="0"
                   Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="项目地址"
                                   Style="{StaticResource ModernTitleLabel}"
                                   FontSize="16"/>
                            <Label Text="查看源码与发布记录"
                                   Style="{StaticResource ModernCaptionLabel}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="打开"
                                BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                                TextColor="{DynamicResource ModernTextPrimary}"
                                CornerRadius="14"
                                WidthRequest="72"
                                HeightRequest="42"
                                Padding="0"
                                Command="{Binding OpenProjectUrlCommand}"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{DynamicResource ModernSurfaceContainer}"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="版本更新"
                                   Style="{StaticResource ModernTitleLabel}"
                                   FontSize="16"/>
                            <Label Text="{Binding UpdateStatusText}"
                                   Style="{StaticResource ModernCaptionLabel}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="检查"
                                BackgroundColor="{DynamicResource ModernPrimary}"
                                TextColor="{DynamicResource ModernTextInverse}"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                WidthRequest="72"
                                HeightRequest="42"
                                Padding="0"
                                Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertedBool}}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
