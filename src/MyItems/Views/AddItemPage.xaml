<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    x:Class="MyItems.Views.AddItemPage"
    x:DataType="viewmodels:AddItemViewModel"
    Title="{Binding PageTitle}"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource SpacingMd}">

                <!-- Scan barcode -->
                <Button
                    Text="📷 扫码录入"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ScanBarcodeCommand}" />

                <!-- Item name -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="物品名称" Style="{StaticResource SubheadLabel}" />
                    <Entry
                        Text="{Binding ItemName}"
                        Placeholder="输入物品名称"
                        Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>

                <!-- Category -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="分类" Style="{StaticResource SubheadLabel}" />
                    <Picker
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        ItemDisplayBinding="{Binding Name}"
                        Style="{StaticResource PickerStyle}" />
                </VerticalStackLayout>

                <!-- Brand -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="品牌" Style="{StaticResource SubheadLabel}" />
                    <Entry
                        Text="{Binding Brand}"
                        Placeholder="如：蒙牛、三九、戴尔"
                        Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>

                <!-- Section: Purchase info -->
                <Label Text="── 购买信息 ──" Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,8" />

                <!-- Purchase date -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="购买日期" Style="{StaticResource SubheadLabel}" />
                    <DatePicker Date="{Binding PurchaseDate}" Format="yyyy-MM-dd" />
                </VerticalStackLayout>

                <!-- Purchase price -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="购入价格" Style="{StaticResource SubheadLabel}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0"
                               Text="{Binding PurchasePrice}"
                               Placeholder="0.00"
                               Keyboard="Numeric"
                               Style="{StaticResource EntryStyle}" />
                        <Label Grid.Column="1" Text="元" VerticalOptions="Center"
                               Margin="{StaticResource SpacingSm},0,0,0"
                               Style="{StaticResource BodyLabel}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Location -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="存放位置" Style="{StaticResource SubheadLabel}" />
                    <Entry
                        Text="{Binding Location}"
                        Placeholder="如：冰箱上层、药箱"
                        Style="{StaticResource EntryStyle}" />
                </VerticalStackLayout>

                <!-- Expiry date + no expiry checkbox -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="保质期" Style="{StaticResource SubheadLabel}" />
                    <DatePicker Date="{Binding ExpiryDate}" Format="yyyy-MM-dd"
                                IsVisible="{Binding NoExpiry, Converter={StaticResource InvertedBool}}" />
                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">
                        <CheckBox IsChecked="{Binding NoExpiry}" VerticalOptions="Center" />
                        <Label Text="无保质期" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Track daily cost -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Grid ColumnDefinitions="*,Auto"
                          MinimumHeightRequest="{StaticResource TouchTargetMinHeight}"
                          ColumnSpacing="{StaticResource SpacingBase}">
                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="{StaticResource SpacingXs}"
                                             VerticalOptions="Center">
                            <Label Text="记录日均成本" Style="{StaticResource SubheadLabel}" />
                            <Label Text="开启后在首页显示日均成本"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding TrackDailyCost}"
                                VerticalOptions="Center"
                                HorizontalOptions="End" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Quantity -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="数量" Style="{StaticResource SubheadLabel}" />
                    <HorizontalStackLayout Spacing="{StaticResource SpacingMd}">
                        <Stepper Value="{Binding Quantity}" Minimum="1" Maximum="999"
                                 HorizontalOptions="Start" />
                        <Label Text="{Binding Quantity, StringFormat='{0} 个'}" Style="{StaticResource BodyLabel}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Notes -->
                <VerticalStackLayout Spacing="{StaticResource SpacingXs}">
                    <Label Text="备注" Style="{StaticResource SubheadLabel}" />
                    <Editor
                        Text="{Binding Notes}"
                        Placeholder="可选备注信息"
                        AutoSize="TextChanges"
                        HeightRequest="80" />
                </VerticalStackLayout>

                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource AppErrorColor}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmpty}}"
                       FontSize="{StaticResource FontSizeCaption}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button -->
        <Button
            Grid.Row="1"
            Text="{Binding SaveButtonText}"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding SaveCommand}"
            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBool}}"
            Margin="{StaticResource PagePadding}" />
    </Grid>
</ContentPage>
