<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    x:Class="MyItems.Views.AddItemPage"
    x:DataType="viewmodels:AddItemViewModel"
    Title="{Binding PageTitle}"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotNullOrEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20"
                Spacing="16">

                <!-- Basic info -->
                <Frame Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Scan button temporarily disabled -->
                        <!--<Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="📦 基础信息"
                                   Style="{StaticResource ModernTitleLabel}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="📷 扫码"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Command="{Binding ScanBarcodeCommand}" />
                        </Grid>-->

                        <!-- Basic info header without scan -->
                        <Label Text="📦 基础信息"
                               Style="{StaticResource ModernTitleLabel}" />

                        <!-- Scanned barcode display - temporarily disabled -->
                        <!--<Frame
                            IsVisible="{Binding Barcode, Converter={StaticResource NotNullOrEmpty}}"
                            BackgroundColor="{DynamicResource ModernSuccessBgColor}"
                            CornerRadius="12"
                            Padding="16,12"
                            HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0"
                                           Text="📱"
                                           FontSize="18"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Barcode, StringFormat='条码: {0}'}"
                                           FontSize="16"
                                           TextColor="{DynamicResource ModernSuccess}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                                <Button Grid.Column="1"
                                        Text="清除"
                                        FontSize="14"
                                        TextColor="White"
                                        BackgroundColor="{DynamicResource ModernError}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Command="{Binding ClearBarcodeCommand}" />
                            </Grid>
                        </Frame>-->

                        <VerticalStackLayout Spacing="12">
                            <Label Text="物品名称" Style="{StaticResource ModernSubheadLabel}" />
                            <Entry
                                Text="{Binding ItemName}"
                                Placeholder="输入物品名称"
                                ReturnType="Next"
                                Style="{StaticResource EntryStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="分类" Style="{StaticResource ModernSubheadLabel}" />
                            <Picker
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                ItemDisplayBinding="{Binding Name}"
                                Title="选择分类"
                                Style="{StaticResource PickerStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="品牌" Style="{StaticResource ModernSubheadLabel}" />
                            <Entry
                                Text="{Binding Brand}"
                                Placeholder="如：蒙牛、三九、戴尔"
                                ReturnType="Next"
                                Style="{StaticResource EntryStyle}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Purchase and storage -->
                <Frame Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="💰 购买与存放"
                               Style="{StaticResource ModernTitleLabel}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="12">
                                <Label Text="购买日期" Style="{StaticResource ModernSubheadLabel}" />
                                <DatePicker
                                    Date="{Binding PurchaseDate}"
                                    Format="yyyy-MM-dd"
                                    Style="{StaticResource DatePickerStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="12">
                                <Label Text="购入价格" Style="{StaticResource ModernSubheadLabel}" />
                                <Entry
                                    Text="{Binding PurchasePrice}"
                                    Placeholder="0.00 元"
                                    Keyboard="Numeric"
                                    ReturnType="Next"
                                    Style="{StaticResource EntryStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="存放位置" Style="{StaticResource ModernSubheadLabel}" />
                            <Entry
                                Text="{Binding Location}"
                                Placeholder="如：冰箱上层、药箱"
                                ReturnType="Next"
                                Style="{StaticResource EntryStyle}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Usage settings -->
                <Frame Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="⏰ 期限与数量"
                               Style="{StaticResource ModernTitleLabel}" />

                        <VerticalStackLayout Spacing="12">
                            <Label Text="保质期" Style="{StaticResource ModernSubheadLabel}" />
                            <DatePicker
                                Date="{Binding ExpiryDate}"
                                Format="yyyy-MM-dd"
                                IsVisible="{Binding NoExpiry, Converter={StaticResource InvertedBool}}"
                                Style="{StaticResource DatePickerStyle}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  MinimumHeightRequest="44">
                                <Label Grid.Column="0"
                                       Text="无保质期"
                                       Style="{StaticResource ModernBodyLabel}"
                                       VerticalOptions="Center" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding NoExpiry}"
                                          VerticalOptions="Center"
                                          HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="44">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="记录日均成本" Style="{StaticResource ModernSubheadLabel}" />
                                <Label Text="首页成本统计"
                                       Style="{StaticResource ModernCaptionLabel}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding TrackDailyCost}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="44">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="数量" Style="{StaticResource ModernSubheadLabel}" />
                                <Label Text="{Binding Quantity, StringFormat='{0} 个'}"
                                       Style="{StaticResource ModernBodyLabel}" />
                            </VerticalStackLayout>
                            <Stepper Grid.Column="1"
                                     Value="{Binding Quantity}"
                                     Minimum="1"
                                     Maximum="999"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End" />
                        </Grid>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="备注" Style="{StaticResource ModernSubheadLabel}" />
                            <Editor
                                Text="{Binding Notes}"
                                Placeholder="可选备注信息"
                                AutoSize="TextChanges"
                                Style="{StaticResource EditorStyle}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save action -->
        <Frame Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="16,8,16,16" Padding="12,10">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource ModernError}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmpty}}"
                       FontSize="13"
                       HorizontalOptions="Center"
                       LineBreakMode="WordWrap"/>
                <Button
                    Text="{Binding SaveButtonText}"
                    Style="{StaticResource ModernPrimaryButton}"
                    HeightRequest="46"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBool}}" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
