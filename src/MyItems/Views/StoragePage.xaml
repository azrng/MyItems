<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:converters="clr-namespace:MyItems.Converters"
    x:Class="MyItems.Views.StoragePage"
    x:DataType="viewmodels:StorageViewModel"
    Title="存储管理"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <!-- Hero header -->
                <Frame
                    WidthRequest="100"
                    HeightRequest="100"
                    CornerRadius="50"
                    BackgroundColor="{DynamicResource ModernPrimary}"
                    HasShadow="True"
                    HorizontalOptions="Center"
                    Padding="0"
                    Margin="0,0,0,16">
                    <Frame.Shadow>
                        <Shadow Brush="{DynamicResource ModernPrimary}"
                                Opacity="0.3"
                                Radius="24"
                                Offset="0,8"/>
                    </Frame.Shadow>
                    <Label Text="💾"
                           FontSize="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Title -->
                <Label Text="存储管理"
                       Style="{StaticResource ModernHeadlineLabel}"
                       FontSize="28"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8"/>

                <Label Text="管理你的数据，随时导入导出"
                       Style="{StaticResource ModernBodyLabel}"
                       TextColor="{DynamicResource ModernTextSecondary}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,16"/>

                <!-- Data operations section -->
                <Frame Style="{StaticResource ModernCardStyle}" Padding="20,16">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="📤 数据导出与导入"
                               Style="{StaticResource ModernTitleLabel}"
                               Margin="0,0,0,8"/>

                        <!-- Export CSV -->
                        <Frame
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            CornerRadius="12"
                            Padding="16,12"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="📤"
                                           FontSize="20"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="导出 CSV"
                                               Style="{StaticResource ModernSubheadLabel}"/>
                                        <Label Text="将所有物品数据导出为 CSV 文件"
                                               Style="{StaticResource ModernCaptionLabel}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="导出数据"
                                        Style="{StaticResource ModernPrimaryButton}"
                                        Command="{Binding ExportCsvCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                                        Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Import CSV -->
                        <Frame
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            CornerRadius="12"
                            Padding="16,12"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="📥"
                                           FontSize="20"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="导入 CSV"
                                               Style="{StaticResource ModernSubheadLabel}"/>
                                        <Label Text="从 CSV 文件导入物品数据"
                                               Style="{StaticResource ModernCaptionLabel}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="导入数据"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        Command="{Binding ImportCsvCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                                        Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Test data section -->
                <Frame Style="{StaticResource ModernCardStyle}" Padding="20,16">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="🧪 测试数据"
                               Style="{StaticResource ModernTitleLabel}"
                               Margin="0,0,0,8"/>

                        <!-- Seed test data -->
                        <Frame
                            BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                            CornerRadius="12"
                            Padding="16,12"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="🎲"
                                           FontSize="20"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="初始化测试数据"
                                               Style="{StaticResource ModernSubheadLabel}"/>
                                        <Label Text="添加一些示例物品，方便测试功能"
                                               Style="{StaticResource ModernCaptionLabel}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="生成测试数据"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        Command="{Binding SeedTestDataCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                                        Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Danger zone -->
                <Frame Style="{StaticResource ModernCardStyle}"
                       Padding="20,16"
                       Margin="0,0,0,100">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="⚠️ 危险操作"
                               Style="{StaticResource ModernTitleLabel}"
                               TextColor="{DynamicResource ModernError}"
                               Margin="0,0,0,8"/>

                        <!-- Clear all data -->
                        <Frame
                            BackgroundColor="{DynamicResource ModernErrorContainer}"
                            CornerRadius="12"
                            Padding="16,12"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="🗑️"
                                           FontSize="20"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="清空所有数据"
                                               Style="{StaticResource ModernSubheadLabel}"
                                               TextColor="{DynamicResource ModernError}"/>
                                        <Label Text="删除所有物品和分类，此操作不可恢复"
                                               Style="{StaticResource ModernCaptionLabel}"
                                               TextColor="{DynamicResource ModernError}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Button Text="清空数据"
                                        BackgroundColor="{DynamicResource ModernError}"
                                        TextColor="{DynamicResource ModernTextInverse}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="50"
                                        Command="{Binding ClearAllDataCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                                        Margin="0,8,0,0">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity" Value="0.8" />
                                                        <Setter Property="Scale" Value="0.95" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </Button>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <Frame BackgroundColor="{DynamicResource ModernSurface}"
                   CornerRadius="16"
                   Padding="24"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{DynamicResource ModernPrimary}"
                        WidthRequest="40"
                        HeightRequest="40"/>
                    <Label Text="处理中..."
                           Style="{StaticResource ModernBodyLabel}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
