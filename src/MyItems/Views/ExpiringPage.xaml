<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MyItems.Converters"
    xmlns:viewmodels="clr-namespace:MyItems.ViewModels"
    xmlns:dtos="clr-namespace:MyItems.Models.DTOs"
    x:Class="MyItems.Views.ExpiringPage"
    x:DataType="viewmodels:ExpiringViewModel"
    Title="临期"
    Style="{StaticResource PageStyle}">

    <ContentPage.Resources>
        <converters:ExpiryStatusToTextColorConverter x:Key="StatusToTextColor" />
        <converters:ExpiryStatusToBgColorConverter x:Key="StatusToBgColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 现代化搜索栏 -->
        <Frame Grid.Row="0"
               Style="{StaticResource ModernCardStyle}"
               Margin="16,10,16,6"
               Padding="10">
            <Frame BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                   CornerRadius="14"
                   Padding="12,6"
                   HasShadow="False">
                <SearchBar Placeholder="搜索临期物品..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}"
                           Margin="0"
                           BackgroundColor="Transparent"
                           FontSize="15"
                           HeightRequest="44"/>
            </Frame>
        </Frame>

        <!-- Two sections: Expiring + Expired with pull-to-refresh -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource ModernPrimary}">
            <ScrollView>
                <VerticalStackLayout Padding="16,6" Spacing="14">

                    <!-- Expiring section with modern header -->
                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasExpiring}">
                        <!-- 降噪后的分区标题 -->
                        <Frame BackgroundColor="{DynamicResource ModernSurface}"
                               CornerRadius="14"
                               Padding="12,10"
                               HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <BoxView Grid.Column="0"
                                         WidthRequest="4"
                                         HeightRequest="30"
                                         CornerRadius="2"
                                         BackgroundColor="{DynamicResource ModernWarning}"
                                         VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="临期提醒"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ModernTextPrimary}"/>
                                    <Label Text="即将过期，请尽快处理"
                                           FontSize="12"
                                           TextColor="{DynamicResource ModernTextSecondary}"/>
                                </VerticalStackLayout>
                                <Frame Grid.Column="2"
                                       BackgroundColor="{DynamicResource ModernWarningContainer}"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding ExpiringItems.Count, StringFormat='{0} 件'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ModernWarningText}"/>
                                </Frame>
                            </Grid>
                        </Frame>

                        <CollectionView
                            ItemsSource="{Binding ExpiringItems}"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dtos:ItemDisplayDto">
                                    <Frame Style="{StaticResource ModernCardStyle}"
                                           Margin="0,0,0,8"
                                           Padding="14">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding ItemName}"
                                                       Style="{StaticResource ModernTitleLabel}"
                                                       FontSize="17"
                                                       LineBreakMode="TailTruncation" />
                                                <Frame Grid.Column="1"
                                                       Style="{StaticResource ModernWarningBadgeStyle}">
                                                    <Label Text="{Binding ExpiryStatusText}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource ModernWarningText}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Frame>
                                            </Grid>

                                            <Label Grid.Row="1"
                                                   Style="{StaticResource ModernBodyLabel}"
                                                   LineBreakMode="TailTruncation">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} · 购买于 {1:yyyy-MM-dd}  {2}  {3}">
                                                        <Binding Path="CategoryName" />
                                                        <Binding Path="PurchaseDate" />
                                                        <Binding Path="Brand" TargetNullValue="" />
                                                        <Binding Path="Location" TargetNullValue="" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                <Frame Grid.Column="0"
                                                       BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                                                       CornerRadius="12"
                                                       Padding="10,6"
                                                       HasShadow="False">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Label Grid.Column="0"
                                                               Text="⏰"
                                                               FontSize="14"
                                                               VerticalOptions="Center"
                                                               Margin="0,0,6,0"/>
                                                        <Label Grid.Column="1"
                                                               Style="{StaticResource ModernCaptionLabel}"
                                                               Text="{Binding ExpiryDate, StringFormat='保质期 {0:yyyy-MM-dd}'}"/>
                                                    </Grid>
                                                </Frame>
                                                <Label Grid.Column="1"
                                                       Text="{Binding DailyCostText}"
                                                       Style="{StaticResource ModernCaptionLabel}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource ModernPrimary}"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding TrackDailyCost}" />
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Expired section with modern header -->
                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasExpired}">
                        <!-- 降噪后的分区标题 -->
                        <Frame BackgroundColor="{DynamicResource ModernSurface}"
                               CornerRadius="14"
                               Padding="12,10"
                               HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <BoxView Grid.Column="0"
                                         WidthRequest="4"
                                         HeightRequest="30"
                                         CornerRadius="2"
                                         BackgroundColor="{DynamicResource ModernError}"
                                         VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="已过期"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ModernTextPrimary}"/>
                                    <Label Text="这些物品已经过期，建议处理"
                                           FontSize="12"
                                           TextColor="{DynamicResource ModernTextSecondary}"/>
                                </VerticalStackLayout>
                                <Frame Grid.Column="2"
                                       BackgroundColor="{DynamicResource ModernErrorContainer}"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding ExpiredItems.Count, StringFormat='{0} 件'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource ModernErrorText}"/>
                                </Frame>
                            </Grid>
                        </Frame>

                        <CollectionView
                            ItemsSource="{Binding ExpiredItems}"
                            ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dtos:ItemDisplayDto">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItem
                                                Text="删除"
                                                BackgroundColor="{DynamicResource ModernError}"
                                                Invoked="OnDeleteItemSwipe"
                                                CommandParameter="{Binding ItemId}" />
                                        </SwipeView.RightItems>
                                        <Frame Style="{StaticResource ModernCardStyle}"
                                               Margin="0,0,0,8"
                                               Padding="14">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding ItemName}"
                                                           Style="{StaticResource ModernTitleLabel}"
                                                           FontSize="17"
                                                           LineBreakMode="TailTruncation" />
                                                    <Frame Grid.Column="1"
                                                           Style="{StaticResource ModernErrorBadgeStyle}">
                                                        <Label Text="{Binding ExpiryStatusText}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource ModernErrorText}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Frame>
                                                </Grid>

                                                <Label Grid.Row="1"
                                                       Style="{StaticResource ModernBodyLabel}"
                                                       LineBreakMode="TailTruncation">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} · 购买于 {1:yyyy-MM-dd}  {2}  {3}">
                                                            <Binding Path="CategoryName" />
                                                            <Binding Path="PurchaseDate" />
                                                            <Binding Path="Brand" TargetNullValue="" />
                                                            <Binding Path="Location" TargetNullValue="" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>

                                                <Frame Grid.Row="2"
                                                       BackgroundColor="{DynamicResource ModernSurfaceContainer}"
                                                       CornerRadius="12"
                                                       Padding="10,6"
                                                       HasShadow="False">
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <Label Grid.Column="0"
                                                               Text="⏰"
                                                               FontSize="14"
                                                               VerticalOptions="Center"
                                                               Margin="0,0,6,0"/>
                                                        <Label Grid.Column="1"
                                                               Style="{StaticResource ModernCaptionLabel}"
                                                               Text="{Binding ExpiryDate, StringFormat='保质期 {0:yyyy-MM-dd}'}"/>
                                                    </Grid>
                                                </Frame>
                                            </Grid>
                                        </Frame>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Empty state -->
                    <StackLayout
                        IsVisible="{Binding IsEmpty}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="20"
                        Padding="40">
                        <Frame WidthRequest="80" HeightRequest="80"
                               CornerRadius="40"
                               BackgroundColor="{DynamicResource ModernSuccess}"
                               HasShadow="True"
                               Padding="0">
                            <Frame.Shadow>
                                <Shadow Brush="{DynamicResource ModernSuccess}"
                                        Opacity="0.3"
                                        Radius="24"
                                        Offset="0,8"/>
                            </Frame.Shadow>
                            <Label Text="✅"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <Label Text="太棒了！"
                               Style="{StaticResource ModernTitleLabel}"
                               HorizontalOptions="Center"/>
                        <Label Text="没有临期或已过期的物品"
                               Style="{StaticResource ModernBodyLabel}"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Loading indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{DynamicResource ModernPrimary}" />
    </Grid>
</ContentPage>
