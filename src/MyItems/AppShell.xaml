<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyItems.Views"
    x:Class="MyItems.AppShell"
    Title="我的物品">

    <Shell.FlyoutHeader>
        <VerticalStackLayout
            Padding="20,40,20,20"
            BackgroundColor="{StaticResource AppPrimaryColor}">
            <Label Text="📦 我的物品"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="物品管理助手"
                   FontSize="14"
                   TextColor="White"
                   Opacity="0.8" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="主页">
        <Tab Title="主页">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="添加">
        <Tab Title="添加">
            <ShellContent ContentTemplate="{DataTemplate views:AddItemPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="分类">
        <Tab Title="分类">
            <ShellContent ContentTemplate="{DataTemplate views:CategoryPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="物品库">
        <Tab Title="物品库">
            <ShellContent ContentTemplate="{DataTemplate views:ItemLibraryPage}" />
        </Tab>
    </FlyoutItem>

    <ShellContent
        Route="itemdetail"
        ContentTemplate="{DataTemplate views:ItemDetailPage}" />

    <MenuItem Text="关于"
              Command="{Binding AboutCommand}"
              Icon="{FontImage FontFamily='Segoe MDL2 Assets', Glyph='&#xE946;', Size=22}" />

</Shell>
