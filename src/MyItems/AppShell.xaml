<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyItems.Views"
    x:Class="MyItems.AppShell"
    Title="我的物品"
    FlyoutBehavior="Disabled"
    BackgroundColor="{DynamicResource AppGray800Color}"
    ForegroundColor="{DynamicResource AppTextInverseColor}"
    TitleColor="{DynamicResource AppTextInverseColor}"
    TabBarBackgroundColor="{DynamicResource AppCardBackgroundColor}"
    TabBarForegroundColor="{DynamicResource AppTextMutedColor}"
    TabBarTitleColor="{DynamicResource AppTextColor}"
    TabBarUnselectedColor="{DynamicResource AppTextDisabledColor}">

    <TabBar>
        <Tab Title="主页">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
        <Tab Title="临期">
            <ShellContent ContentTemplate="{DataTemplate views:ExpiringPage}" />
        </Tab>
        <Tab Title="物品库">
            <ShellContent ContentTemplate="{DataTemplate views:ItemLibraryPage}" />
        </Tab>
    </TabBar>

</Shell>
