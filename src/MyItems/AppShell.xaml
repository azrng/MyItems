<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyItems.Views"
    x:Class="MyItems.AppShell"
    Title="我的物品"
    FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource AppGray800Color}"
    ForegroundColor="{StaticResource AppTextInverseColor}"
    TitleColor="{StaticResource AppTextInverseColor}"
    TabBarBackgroundColor="{StaticResource AppCardBackgroundColor}"
    TabBarForegroundColor="{StaticResource AppTextMutedColor}"
    TabBarTitleColor="{StaticResource AppTextColor}"
    TabBarUnselectedColor="{StaticResource AppTextDisabledColor}">

    <TabBar>
        <Tab Title="主页">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
        <Tab Title="物品库">
            <ShellContent ContentTemplate="{DataTemplate views:ItemLibraryPage}" />
        </Tab>
    </TabBar>

</Shell>
