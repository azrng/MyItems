<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyItems.Resources.Styles.Colors">

    <!-- Brand -->
    <Color x:Key="AppPrimaryColor">#2E8BFF</Color>
    <Color x:Key="AppPrimaryDarkColor">#5AAFFF</Color>
    <Color x:Key="AppPrimaryContainerColor">#D9EEFF</Color>

    <Color x:Key="AppSecondaryColor">#22A97E</Color>
    <Color x:Key="AppSecondaryDarkColor">#4EC89D</Color>
    <Color x:Key="AppSecondaryContainerColor">#D9F6EE</Color>

    <!-- Status -->
    <Color x:Key="AppSuccessColor">#1CBD5D</Color>
    <Color x:Key="AppSuccessBgColor">#DCFBE6</Color>
    <Color x:Key="AppWarningColor">#EA9B12</Color>
    <Color x:Key="AppWarningBgColor">#FEEFC8</Color>
    <Color x:Key="AppErrorColor">#F0445E</Color>
    <Color x:Key="AppErrorBgColor">#FFE0E4</Color>

    <!-- Gray scale -->
    <Color x:Key="AppGray50Color">#F8FAFC</Color>
    <Color x:Key="AppGray100Color">#F1F5F9</Color>
    <Color x:Key="AppGray200Color">#E2E8F0</Color>
    <Color x:Key="AppGray300Color">#CBD5E1</Color>
    <Color x:Key="AppGray400Color">#94A3B8</Color>
    <Color x:Key="AppGray500Color">#64748B</Color>
    <Color x:Key="AppGray600Color">#475569</Color>
    <Color x:Key="AppGray700Color">#334155</Color>
    <Color x:Key="AppGray800Color">#1E293B</Color>
    <Color x:Key="AppGray900Color">#0F172A</Color>

    <!-- Semantic: Text -->
    <Color x:Key="AppTextColor">#0F172A</Color>
    <Color x:Key="AppTextSecondaryColor">#475569</Color>
    <Color x:Key="AppTextMutedColor">#64748B</Color>
    <Color x:Key="AppTextDisabledColor">#94A3B8</Color>
    <Color x:Key="AppTextInverseColor">White</Color>
    <Color x:Key="AppTextLinkColor">#2E8BFF</Color>

    <!-- Semantic: Background -->
    <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
    <Color x:Key="AppCardBackgroundColor">White</Color>
    <Color x:Key="AppSurfaceColor">#F1F5F9</Color>
    <Color x:Key="AppActiveBackgroundColor">#D9EEFF</Color>
    <Color x:Key="AppBrandBackgroundColor">#2E8BFF</Color>

    <!-- Semantic: Border -->
    <Color x:Key="AppBorderColor">#E2E8F0</Color>
    <Color x:Key="AppBorderStrongColor">#CBD5E1</Color>
    <Color x:Key="AppBorderFocusColor">#2E8BFF</Color>

    <!-- Expiry status -->
    <Color x:Key="AppExpiredColor">#F0445E</Color>
    <Color x:Key="AppExpiredBgColor">#FFE0E4</Color>
    <Color x:Key="AppExpiringColor">#EA9B12</Color>
    <Color x:Key="AppExpiringBgColor">#FEEFC8</Color>
    <Color x:Key="AppSafeColor">#1CBD5D</Color>
    <Color x:Key="AppSafeBgColor">#DCFBE6</Color>
    <Color x:Key="AppNoExpiryColor">#2E8BFF</Color>
    <Color x:Key="AppNoExpiryBgColor">#D9EEFF</Color>

</ResourceDictionary>
