<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyItems.Resources.Styles.Colors">

    <!-- Modern Brand Colors - 年轻化配色 -->
    <Color x:Key="AppPrimaryColor">#FF6B6B</Color>              <!-- 珊瑚粉 -->
    <Color x:Key="AppPrimaryDarkColor">#FF5252</Color>          <!-- 深珊瑚粉 -->
    <Color x:Key="AppPrimaryContainerColor">#FFB3B3</Color>     <!-- 浅珊瑚粉 -->

    <Color x:Key="AppSecondaryColor">#4ECDC4</Color>            <!-- 清新薄荷 -->
    <Color x:Key="AppSecondaryDarkColor">#3DB8B0</Color>        <!-- 深薄荷 -->
    <Color x:Key="AppSecondaryContainerColor">#7EDDD6</Color>   <!-- 浅薄荷 -->

    <Color x:Key="AppAccentColor">#FFE66D</Color>              <!-- 活力黄 -->

    <!-- Status Colors - 现代化状态色 -->
    <Color x:Key="AppSuccessColor">#22A97E</Color>             <!-- 成功 - 稳定绿 -->
    <Color x:Key="AppSuccessBgColor">#E0F7F4</Color>           <!-- 成功背景 -->
    <Color x:Key="AppWarningColor">#B76A00</Color>             <!-- 警告 - 琥珀文字 -->
    <Color x:Key="AppWarningBgColor">#FFF1B8</Color>           <!-- 警告背景 -->
    <Color x:Key="AppErrorColor">#D92D46</Color>               <!-- 错误 - 危险红 -->
    <Color x:Key="AppErrorBgColor">#FFE4E8</Color>             <!-- 错误背景 -->
    <Color x:Key="AppInfoColor">#4D9DE0</Color>                <!-- 信息 - 天空蓝 -->
    <Color x:Key="AppInfoBgColor">#E0F0FF</Color>              <!-- 信息背景 -->

    <!-- Gray scale - 更柔和的灰度 -->
    <Color x:Key="AppGray50Color">#FAFAFA</Color>
    <Color x:Key="AppGray100Color">#F5F5F5</Color>
    <Color x:Key="AppGray200Color">#EEEEEE</Color>
    <Color x:Key="AppGray300Color">#E0E0E0</Color>
    <Color x:Key="AppGray400Color">#BDBDBD</Color>
    <Color x:Key="AppGray500Color">#999999</Color>
    <Color x:Key="AppGray600Color">#757575</Color>
    <Color x:Key="AppGray700Color">#616161</Color>
    <Color x:Key="AppGray800Color">#424242</Color>
    <Color x:Key="AppGray900Color">#212121</Color>

    <!-- Semantic: Text - 现代化文字颜色 -->
    <Color x:Key="AppTextColor">#1A1A1A</Color>               <!-- 主要文字 -->
    <Color x:Key="AppTextSecondaryColor">#666666</Color>       <!-- 次要文字 -->
    <Color x:Key="AppTextMutedColor">#999999</Color>          <!-- 弱化文字 -->
    <Color x:Key="AppTextDisabledColor">#CCCCCC</Color>       <!-- 禁用文字 -->
    <Color x:Key="AppTextInverseColor">#FFFFFF</Color>        <!-- 反色文字 -->
    <Color x:Key="AppTextLinkColor">#FF6B6B</Color>           <!-- 链接颜色 - 使用主色 -->

    <!-- Semantic: Background - 现代化背景色 -->
    <Color x:Key="AppBackgroundColor">#FAFAFA</Color>          <!-- 页面背景 -->
    <Color x:Key="AppCardBackgroundColor">#FFFFFF</Color>     <!-- 卡片背景 -->
    <Color x:Key="AppSurfaceColor">#F8F9FA</Color>           <!-- 表面背景 -->
    <Color x:Key="AppActiveBackgroundColor">#FFE8E8</Color>   <!-- 激活背景 -->
    <Color x:Key="AppBrandBackgroundColor">#FF6B6B</Color>     <!-- 品牌背景 -->

    <!-- Semantic: Border - 现代化边框色 -->
    <Color x:Key="AppBorderColor">#EEEEEE</Color>             <!-- 边框 -->
    <Color x:Key="AppBorderStrongColor">#E0E0E0</Color>       <!-- 强边框 -->
    <Color x:Key="AppBorderFocusColor">#FF6B6B</Color>        <!-- 焦点边框 -->

    <!-- Expiry status - 保持兼容性，但更新为年轻化配色 -->
    <Color x:Key="AppExpiredColor">#D92D46</Color>            <!-- 已过期 -->
    <Color x:Key="AppExpiredBgColor">#FFE4E8</Color>
    <Color x:Key="AppExpiringColor">#B76A00</Color>           <!-- 临期 -->
    <Color x:Key="AppExpiringBgColor">#FFF1B8</Color>
    <Color x:Key="AppSafeColor">#22A97E</Color>               <!-- 安全 -->
    <Color x:Key="AppSafeBgColor">#E0F7F4</Color>
    <Color x:Key="AppNoExpiryColor">#4D9DE0</Color>           <!-- 无保质期 -->
    <Color x:Key="AppNoExpiryBgColor">#E0F0FF</Color>

    <!-- UraniumUI Material Theme Colors - 现代化配色 -->
    <Color x:Key="ModernPrimary">#FF6B6B</Color>              <!-- 珊瑚粉 -->
    <Color x:Key="ModernPrimaryDark">#FF5252</Color>          <!-- 深珊瑚粉 -->
    <Color x:Key="ModernPrimaryLight">#FFB3B3</Color>         <!-- 浅珊瑚粉 -->

    <Color x:Key="ModernSecondary">#4ECDC4</Color>            <!-- 清新薄荷 -->
    <Color x:Key="ModernSecondaryDark">#3DB8B0</Color>        <!-- 深薄荷 -->
    <Color x:Key="ModernSecondaryLight">#7EDDD6</Color>       <!-- 浅薄荷 -->

    <Color x:Key="ModernAccent">#FFE66D</Color>               <!-- 活力黄 -->
    <Color x:Key="ModernAccentDark">#FFD93D</Color>           <!-- 深活力黄 -->

    <Color x:Key="ModernSurface">#FFFFFF</Color>              <!-- 主背景 -->
    <Color x:Key="ModernSurfaceVariant">#F8F9FA</Color>       <!-- 变体背景 -->
    <Color x:Key="ModernSurfaceContainer">#F1F3F5</Color>     <!-- 容器背景 -->

    <Color x:Key="ModernBackground">#FAFAFA</Color>           <!-- 页面背景 -->
    <Color x:Key="ModernOnBackground">#1A1A1A</Color>         <!-- 背景文字 -->

    <Color x:Key="ModernError">#D92D46</Color>                <!-- 错误 -->
    <Color x:Key="ModernErrorContainer">#FFE4E8</Color>       <!-- 错误容器 -->
    <Color x:Key="ModernErrorText">#B42318</Color>            <!-- 错误文字 -->
    <Color x:Key="ModernSuccess">#22A97E</Color>              <!-- 成功 -->
    <Color x:Key="ModernSuccessContainer">#DCFBE6</Color>     <!-- 成功容器 -->
    <Color x:Key="ModernSuccessText">#146C52</Color>          <!-- 成功文字 -->
    <Color x:Key="ModernWarning">#F5B51B</Color>              <!-- 警告 -->
    <Color x:Key="ModernWarningContainer">#FFF1B8</Color>     <!-- 警告容器 -->
    <Color x:Key="ModernWarningText">#7A4A00</Color>          <!-- 警告文字 -->
    <Color x:Key="ModernInfo">#4D9DE0</Color>                 <!-- 信息 -->
    <Color x:Key="ModernInfoContainer">#D9EEFF</Color>        <!-- 信息容器 -->
    <Color x:Key="ModernInfoText">#1E5F96</Color>             <!-- 信息文字 -->

    <!-- Modern Text Colors -->
    <Color x:Key="ModernTextPrimary">#1A1A1A</Color>          <!-- 主要文字 -->
    <Color x:Key="ModernTextSecondary">#666666</Color>        <!-- 次要文字 -->
    <Color x:Key="ModernTextHint">#999999</Color>             <!-- 提示文字 -->
    <Color x:Key="ModernTextDisabled">#CCCCCC</Color>         <!-- 禁用文字 -->
    <Color x:Key="ModernTextInverse">#FFFFFF</Color>          <!-- 反色文字 -->

    <!-- Modern Typography - 平台字体 -->
    <OnPlatform x:TypeArguments="x:String" x:Key="ModernDisplayFont">
        <On Platform="Android" Value="sans-serif-medium" />
        <On Platform="iOS" Value="SFProDisplay-Medium" />
        <On Platform="WinUI" Value="SegoeUIVariable-Semibold" />
    </OnPlatform>

    <OnPlatform x:TypeArguments="x:String" x:Key="ModernBodyFont">
        <On Platform="Android" Value="sans-serif" />
        <On Platform="iOS" Value="SFProText-Regular" />
        <On Platform="WinUI" Value="SegoeUIVariable-Regular" />
    </OnPlatform>

</ResourceDictionary>
