<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyItems.Resources.Styles.Styles">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Sizes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Page -->
    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppBackgroundColor}" />
    </Style>

    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource AppBorderColor}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="ListCardStyle" TargetType="Frame" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="FormSectionCardStyle" TargetType="Frame" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BottomActionFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource AppBorderColor}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource BottomActionPadding}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Margin" Value="{StaticResource PagePadding}" />
    </Style>

    <!-- Typography -->
    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
    </Style>

    <Style x:Key="SubheadLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextSecondaryColor}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextMutedColor}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppPrimaryColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextInverseColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppActiveBackgroundColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppPrimaryColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="WidthRequest" Value="{StaticResource TouchTargetMinHeight}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="TitleIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppGray800Color}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextInverseColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="WidthRequest" Value="{StaticResource TouchTargetMinHeight}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSurfaceColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="CompactSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="WidthRequest" Value="{StaticResource CompactButtonWidth}" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppErrorColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextInverseColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="DangerSoftButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppErrorBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppErrorColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="SuccessSoftButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AppSuccessBgColor}" />
        <Setter Property="TextColor" Value="{DynamicResource AppSuccessColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Input -->
    <Style x:Key="SearchBarStyle" TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextDisabledColor}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource AppTextSecondaryColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
    </Style>

    <Style x:Key="EntryStyle" TargetType="Entry">
        <Setter Property="HeightRequest" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextDisabledColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
    </Style>

    <Style x:Key="PickerStyle" TargetType="Picker">
        <Setter Property="HeightRequest" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource AppTextSecondaryColor}" />
    </Style>

    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="HeightRequest" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
    </Style>

    <Style x:Key="EditorStyle" TargetType="Editor">
        <Setter Property="HeightRequest" Value="{StaticResource EditorHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource AppTextDisabledColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBackgroundColor}" />
    </Style>

    <!-- Section header -->
    <Style x:Key="SectionHeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
    </Style>

    <!-- Status badge -->
    <Style x:Key="StatusBadgeFrame" TargetType="Frame">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="StatusBadgeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Modern Styles - UraniumUI兼容样式 -->
    <Style x:Key="ModernCardStyle" TargetType="Frame">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernSurface}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Margin" Value="16,6" />
    </Style>

    <Style x:Key="ModernPrimaryButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernPrimary}" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextInverse}" />
        <Setter Property="FontFamily" Value="{DynamicResource ModernBodyFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="ModernSecondaryButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernSurfaceContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource ModernBodyFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="ModernBadgeStyle" TargetType="Frame">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="ModernWarningBadgeStyle" TargetType="Frame">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumWidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernWarningContainer}" />
        <Setter Property="BorderColor" Value="{DynamicResource ModernWarning}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="ModernErrorBadgeStyle" TargetType="Frame">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumWidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ModernErrorContainer}" />
        <Setter Property="BorderColor" Value="{DynamicResource ModernError}" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="ModernHeadlineLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource ModernDisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ModernTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource ModernDisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
    </Style>

    <Style x:Key="ModernSubheadLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource ModernBodyFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextPrimary}" />
    </Style>

    <Style x:Key="ModernBodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource ModernBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextSecondary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="ModernCaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource ModernBodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource ModernTextHint}" />
    </Style>

</ResourceDictionary>
