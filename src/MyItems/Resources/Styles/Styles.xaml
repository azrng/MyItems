<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyItems.Resources.Styles.Styles">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Sizes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Page -->
    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackgroundColor}" />
    </Style>

    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource AppCardBackgroundColor}" />
        <Setter Property="BorderColor" Value="{StaticResource AppBorderColor}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Typography -->
    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="SemiBold" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
    </Style>

    <Style x:Key="SubheadLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextSecondaryColor}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextMutedColor}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AppPrimaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextInverseColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="FontAttributes" Value="SemiBold" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AppSurfaceColor}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AppErrorColor}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextInverseColor}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- Input -->
    <Style x:Key="EntryStyle" TargetType="Entry">
        <Setter Property="HeightRequest" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource AppTextDisabledColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource AppCardBackgroundColor}" />
    </Style>

    <Style x:Key="PickerStyle" TargetType="Picker">
        <Setter Property="HeightRequest" Value="{StaticResource InputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
        <Setter Property="TitleColor" Value="{StaticResource AppTextSecondaryColor}" />
    </Style>

    <!-- Section header -->
    <Style x:Key="SectionHeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubhead}" />
        <Setter Property="FontAttributes" Value="SemiBold" />
        <Setter Property="TextColor" Value="{StaticResource AppTextColor}" />
    </Style>

    <!-- Status badge -->
    <Style x:Key="StatusBadgeFrame" TargetType="Frame">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="StatusBadgeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontAttributes" Value="SemiBold" />
    </Style>

</ResourceDictionary>
