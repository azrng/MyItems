<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyItems.Resources.Styles.Sizes">

    <!-- Spacing -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingBase">16</x:Double>
    <x:Double x:Key="SpacingLg">20</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>
    <x:Double x:Key="SpacingXxl">32</x:Double>

    <!-- Page padding -->
    <x:Double x:Key="PagePaddingHorizontal">16</x:Double>
    <Thickness x:Key="PagePadding">16,0</Thickness>

    <!-- Card -->
    <x:Double x:Key="CardPadding">16</x:Double>
    <x:Double x:Key="CardRadius">12</x:Double>

    <!-- Radius -->
    <x:Double x:Key="RadiusSm">6</x:Double>
    <x:Double x:Key="RadiusMd">10</x:Double>
    <x:Double x:Key="RadiusLg">14</x:Double>
    <x:Double x:Key="RadiusXl">20</x:Double>
    <x:Double x:Key="RadiusFull">28</x:Double>

    <!-- Touch target -->
    <x:Double x:Key="TouchTargetMinHeight">48</x:Double>
    <x:Double x:Key="ButtonHeight">44</x:Double>
    <x:Double x:Key="InputHeight">44</x:Double>
    <x:Double x:Key="BarHeight">48</x:Double>
    <x:Double x:Key="IconSize">24</x:Double>

    <!-- Font size -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubhead">16</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeHeadline">22</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- Section / item gap -->
    <x:Double x:Key="SectionGap">24</x:Double>
    <x:Double x:Key="ItemGap">12</x:Double>

</ResourceDictionary>
